@model BrasilBurger.Web.Models.Entities.Client
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Inscription - Brasil Burger</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        body {
            background: linear-gradient(135deg, #002776 0%, #009739 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            margin: 0;
        }
        
        .register-container {
            width: 100%;
            max-width: 450px;
        }
        
        .register-card {
            background: white;
            border-radius: 15px;
            padding: 2.5rem;
            box-shadow: 0 10px 40px rgba(0,0,0,0.3);
        }
        
        .register-header {
            text-align: center;
            margin-bottom: 2rem;
        }
        
        .logo {
            color: #002776;
            font-weight: bold;
            font-size: 1.8rem;
            text-decoration: none;
        }
        
        .logo span {
            color: #009739;
        }
        
        .logo i {
            color: #FEDF00;
        }
        
        .btn-register {
            background: linear-gradient(135deg, #002776 0%, #009739 100%);
            color: white;
            border: none;
            padding: 12px;
            font-weight: 600;
            width: 100%;
            border-radius: 8px;
            transition: all 0.3s ease;
        }
        
        .btn-register:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 39, 118, 0.4);
        }
        
        .back-link {
            display: block;
            text-align: center;
            margin-top: 1.5rem;
            color: #6c757d;
            text-decoration: none;
            transition: color 0.3s ease;
        }
        
        .back-link:hover {
            color: #002776;
        }
        
        .form-control:focus {
            border-color: #009739;
            box-shadow: 0 0 0 0.25rem rgba(0, 151, 57, 0.25);
        }
        
        .text-danger {
            font-size: 0.875rem;
            margin-top: 0.25rem;
        }
        
        .form-label {
            font-weight: 600;
            color: #495057;
            margin-bottom: 0.5rem;
        }
        
        .tel-prefix {
            background-color: #e9ecef;
            color: #495057;
            font-weight: 500;
            border: 1px solid #ced4da;
            border-right: 0;
        }
        
        .tel-input {
            border-left: 0;
        }
        
        .tel-input:focus {
            border-left: 1px solid #009739;
        }
    </style>
</head>
<body>
    <div class="register-container">
        <div class="register-card">
            <!-- Logo / Titre -->
            <div class="register-header">
                <a asp-controller="Home" asp-action="Index" class="logo text-decoration-none">
                    <i class="fas fa-hamburger"></i>
                    <span>BRASIL</span> BURGER
                </a>
                <h4 class="mt-3">Créez votre compte</h4>
                <p class="text-muted">Rejoignez notre communauté de gourmets</p>
            </div>
            
            <!-- Formulaire d'inscription -->
            <form asp-action="Register" method="post" id="registerForm">
                <!-- Nom et Prénom sur la même ligne -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Nom" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-user"></i>
                            </span>
                            <input asp-for="Nom" class="form-control" placeholder="Votre nom" required>
                        </div>
                        <span asp-validation-for="Nom" class="text-danger"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="Prenom" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-user"></i>
                            </span>
                            <input asp-for="Prenom" class="form-control" placeholder="Votre prénom" required>
                        </div>
                        <span asp-validation-for="Prenom" class="text-danger"></span>
                    </div>
                </div>
                
                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-envelope"></i>
                        </span>
                        <input asp-for="Email" type="email" class="form-control" placeholder="votre@email.com" required>
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                
                <!-- Téléphone avec +221 fixe -->
                <div class="mb-3">
                    <label asp-for="Telephone" class="form-label">Téléphone</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-phone"></i>
                        </span>
                        <span class="input-group-text tel-prefix">+221</span>
                        <input asp-for="Telephone" class="form-control tel-input" 
                               id="telephoneInput"
                               placeholder="77 123 45 67" 
                               required
                               maxlength="14"> <!-- 9 chiffres + 3 espaces = 12 + marge -->
                    </div>
                    <span asp-validation-for="Telephone" class="text-danger"></span>
                    <small class="form-text text-muted">
                        <i class="fas fa-info-circle"></i> Format: 77 123 45 67
                    </small>
                </div>
                
                <!-- Mot de passe -->
                <div class="mb-4">
                    <label asp-for="MotDePasse" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-lock"></i>
                        </span>
                        <input asp-for="MotDePasse" type="password" class="form-control" placeholder="Votre mot de passe" required>
                    </div>
                    <span asp-validation-for="MotDePasse" class="text-danger"></span>
                    <small class="form-text text-muted">
                        <i class="fas fa-info-circle"></i> Minimum 6 caractères
                    </small>
                </div>
                
                <!-- Bouton d'inscription -->
                <button type="submit" class="btn btn-register mb-3">
                    <i class="fas fa-user-plus me-2"></i> S'inscrire
                </button>
            </form>
            
            <!-- Lien de connexion -->
            <div class="text-center mb-3">
                <p class="mb-0">Déjà un compte ?</p>
                <a asp-action="Login" class="text-decoration-none fw-bold" 
                   style="color: #009739;">
                    <i class="fas fa-sign-in-alt me-1"></i> Se connecter
                </a>
            </div>
            
            <!-- Bouton Retour à l'accueil -->
            <div class="text-center">
                <a asp-controller="Home" asp-action="Index" class="back-link">
                    <i class="fas fa-arrow-left me-1"></i> Retour à l'accueil
                </a>
            </div>
            
            <!-- Messages d'erreur/succès -->
            @if (ViewData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger mt-3">
                    <i class="fas fa-exclamation-circle me-2"></i> 
                    @ViewData["ErrorMessage"]
                </div>
            }
            
            @if (ViewData["SuccessMessage"] != null)
            {
                <div class="alert alert-success mt-3">
                    <i class="fas fa-check-circle me-2"></i> 
                    @ViewData["SuccessMessage"]
                </div>
            }
            
            <!-- Affichage des erreurs de validation du modèle -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-warning mt-3">
                    <h6 class="alert-heading"><i class="fas fa-exclamation-triangle me-2"></i>Veuillez corriger les erreurs :</h6>
                    <div asp-validation-summary="All" class="mb-0 small"></div>
                </div>
            }
        </div>
    </div>
    
    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Validation côté client -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    
    <script>
        $(document).ready(function() {
            $('.register-card').hide().fadeIn(400);
            
            // Focus sur le premier champ
            $('#Nom').focus();
            
            // Format du téléphone : 77 123 45 67
            $('#telephoneInput').on('input', function() {
                let value = $(this).val().replace(/\D/g, '');
                
                // Garde seulement les 9 premiers chiffres
                if (value.length > 9) {
                    value = value.substring(0, 9);
                }
                
                // Format: XX XXX XX XX
                let formatted = '';
                if (value.length > 0) {
                    // Deux premiers chiffres
                    formatted = value.substring(0, 2);
                    
                    if (value.length > 2) {
                        // Trois chiffres suivants
                        formatted += ' ' + value.substring(2, 5);
                    }
                    
                    if (value.length > 5) {
                        // Deux chiffres suivants
                        formatted += ' ' + value.substring(5, 7);
                    }
                    
                    if (value.length > 7) {
                        // Deux derniers chiffres
                        formatted += ' ' + value.substring(7, 9);
                    }
                }
                
                $(this).val(formatted);
            });
            
            // Avant l'envoi du formulaire, combine +221 avec le numéro formaté
            $('#registerForm').on('submit', function() {
                var telephoneInput = $('#telephoneInput');
                var numeroFormatte = telephoneInput.val().trim();
                
                // Vérifie si le numéro a le bon format (9 chiffres)
                var chiffresOnly = numeroFormatte.replace(/\D/g, '');
                if (chiffresOnly.length !== 9) {
                    alert('Veuillez entrer un numéro valide (9 chiffres)');
                    return false;
                }
                
                // Combine avec +221
                var numeroComplet = '+221 ' + numeroFormatte;
                
                // Met à jour la valeur du champ pour l'envoi
                telephoneInput.val(numeroComplet);
                
                return true;
            });
            
            // Si le champ a déjà une valeur (en cas d'erreur de validation), formatte-la
            var existingTel = $('#telephoneInput').val();
            if (existingTel && existingTel.includes('+221')) {
                // Enlève le +221 s'il est déjà là
                var numeroSansPrefixe = existingTel.replace('+221', '').trim();
                $('#telephoneInput').val(numeroSansPrefixe);
            }
        });
    </script>
</body>
</html>