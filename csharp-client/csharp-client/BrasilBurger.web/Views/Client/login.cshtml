@{
    Layout = null; // ⬅️ Pas de layout
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connexion - Brasil Burger</title>
    
    <!-- Les mêmes CDN que ton layout -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        body {
            background: linear-gradient(135deg, #002776 0%, #009739 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            margin: 0;
        }
        
        .login-container {
            width: 100%;
            max-width: 400px;
        }
        
        .login-card {
            background: white;
            border-radius: 15px;
            padding: 2.5rem;
            box-shadow: 0 10px 40px rgba(0,0,0,0.3);
        }
        
        .login-header {
            text-align: center;
            margin-bottom: 2rem;
        }
        
        .logo {
            color: #002776;
            font-weight: bold;
            font-size: 1.8rem;
            text-decoration: none;
        }
        
        .logo span {
            color: #009739;
        }
        
        .logo i {
            color: #FEDF00;
        }
        
        .btn-login {
            background: linear-gradient(135deg, #002776 0%, #009739 100%);
            color: white;
            border: none;
            padding: 12px;
            font-weight: 600;
            width: 100%;
            border-radius: 8px;
            transition: all 0.3s ease;
        }
        
        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 39, 118, 0.4);
        }
        
        .back-link {
            display: block;
            text-align: center;
            margin-top: 1.5rem;
            color: #6c757d;
            text-decoration: none;
            transition: color 0.3s ease;
        }
        
        .back-link:hover {
            color: #002776;
        }
        
        .form-control:focus {
            border-color: #009739;
            box-shadow: 0 0 0 0.25rem rgba(0, 151, 57, 0.25);
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <!-- Logo / Titre -->
            <div class="login-header">
                <a asp-controller="Home" asp-action="Index" class="logo text-decoration-none">
                    <i class="fas fa-hamburger"></i>
                    <span>BRASIL</span> BURGER
                </a>
                <h4 class="mt-3">Connexion à votre compte</h4>
            </div>
            
            <!-- Formulaire de connexion -->
            <form asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-envelope"></i>
                        </span>
                        <input type="email" class="form-control" id="email" name="email" 
                               placeholder="votre@email.com" required>
                    </div>
                </div>
                
                <div class="mb-4">
                    <label for="motDePasse" class="form-label">Mot de passe</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-lock"></i>
                        </span>
                        <input type="password" class="form-control" id="motDePasse" name="motDePasse" 
                               placeholder="Votre mot de passe" required>
                    </div>
                </div>
                
                <button type="submit" class="btn btn-login mb-3">
                    <i class="fas fa-sign-in-alt me-2"></i> Se connecter
                </button>
            </form>
            
            <!-- Lien d'inscription -->
            <div class="text-center mb-3">
                <p class="mb-0">Pas encore de compte ?</p>
                <a asp-action="Register" class="text-decoration-none fw-bold" 
                   style="color: #009739;">
                    <i class="fas fa-user-plus me-1"></i> Créer un compte
                </a>
            </div>
            
            <!-- Bouton Retour à l'accueil -->
            <div class="text-center">
                <a asp-controller="Home" asp-action="Index" class="back-link">
                    <i class="fas fa-arrow-left me-1"></i> Retour à l'accueil
                </a>
            </div>
            
            <!-- Messages d'erreur/succès -->
            @if (ViewData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger mt-3">
                    <i class="fas fa-exclamation-circle me-2"></i> 
                    @ViewData["ErrorMessage"]
                </div>
            }
            
            @if (ViewData["SuccessMessage"] != null)
            {
                <div class="alert alert-success mt-3">
                    <i class="fas fa-check-circle me-2"></i> 
                    @ViewData["SuccessMessage"]
                </div>
            }
        </div>
    </div>
    
    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Animation simple pour le formulaire
        $(document).ready(function() {
            $('.login-card').hide().fadeIn(400);
        });
    </script>
</body>
</html>