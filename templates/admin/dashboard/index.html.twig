<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ page_title }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .stat-card {
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            color: white;
        }
        .stat-card h5 {
            font-size: 14px;
            margin-bottom: 10px;
        }
        .stat-card h2 {
            font-size: 32px;
            font-weight: bold;
        }
    </style>
</head>
<body >
<div class="container mt-4 mb-5">
    <h1>Dashboard Admin</h1>
    <p>Connecté : {{ app.session.get('admin_email') }}</p>
    
    <h3 class="mb-3">Statistiques Générales</h3>
    <div class="row mt-4">
        <div class="col-md-3">
            <div class="stat-card bg-primary">
                <h5>Clients</h5>
                <h2>{{ stats.total_clients|default(0) }}</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card bg-success">
                <h5>Commandes Aujourd'hui</h5>
                <h2>{{ stats.commandes_du_jour|default(0) }}</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card bg-info">
                <h5>Chiffre d'Affaires</h5>
                <h2>{{ stats.chiffre_affaires|default(0)|number_format(0, ',', ' ') }}</h2>
                <small>FCFA</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card bg-warning text-dark">
                <h5>Livreurs Actifs</h5>
                <h2>{{ stats.livreurs_actifs|default(0) }}</h2>
            </div>
        </div>
    </div>
    
    <h3 class="mb-3 mt-4">Statistiques du Jour</h3>
    <div class="row">
        <div class="col-md-3">
            <div class="stat-card bg-primary">
                <h5>Commandes en Cours</h5>
                <h2>{{ statsAvancees.commandes_en_cours_jour|default(0) }}</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card bg-success">
                <h5>Commandes Terminées</h5>
                <h2>{{ statsAvancees.commandes_terminees_jour|default(0) }}</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card bg-info">
                <h5>Recettes Journalières</h5>
                <h2>{{ statsAvancees.recettes_journalieres|default(0)|number_format(0, ',', ' ') }}</h2>
                <small>FCFA</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card bg-danger">
                <h5>Commandes Annulées</h5>
                <h2>{{ statsAvancees.commandes_annulees_jour|default(0) }}</h2>
            </div>
        </div>
    </div>
    
    <h3 class="mb-3 mt-4">🏆 Top Ventes du Jour</h3>
    <div class="card">
        <div class="card-body">
            {% if topVentes is empty %}
                <p class="text-muted">Aucune vente aujourd'hui</p>
            {% else %}
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Position</th>
                            <th>Produit</th>
                            <th>Type</th>
                            <th>Quantité Vendue</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for index, vente in topVentes %}
                        <tr>
                            <td>
                                {% if index == 0 %}🥇
                                {% elseif index == 1 %}🥈
                                {% elseif index == 2 %}🥉
                                {% else %}{{ index + 1 }}
                                {% endif %}
                            </td>
                            <td><strong>{{ vente.nom_produit }}</strong></td>
                            <td>
                                <span class="badge bg-{{ vente.type_produit == 'BURGER' ? 'warning' : 'info' }}">
                                    {{ vente.type_produit }}
                                </span>
                            </td>
                            <td>{{ vente.quantite_totale }} unités</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
    
    <div class="mt-4">
        <a href="{{ path('admin_commandes') }}" class="btn btn-primary">📦 Voir Commandes</a>
        <a href="{{ path('app_logout') }}" class="btn btn-danger">🚪 Déconnexion</a>
    </div>
</div>
</body>
</html>