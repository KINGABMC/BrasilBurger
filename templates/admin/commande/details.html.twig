<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ page_title }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --brasil-green: #009739;
            --brasil-yellow: #FEDD00;
            --brasil-blue: #012169;
            --burger-orange: #FF6B35;
            --teal: #17a2b8;
            --dark-text: #2d3748;
            --light-gray: #f7fafc;
        }

        body {
            background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }

        .container {
            max-width: 1400px;
            padding: 2rem;
        }

        /* Header */
        h2 {
        color: var(--dark-text);
        font-weight: 900;
        font-size: 2.5rem;
        margin-bottom: 1.5rem;
        letter-spacing: -0.5px;
    }

    h2::first-letter {
        background: linear-gradient(135deg, var(--brasil-green), #00b547);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
       }

        /* Buttons */
        .btn {
            padding: 12px 28px;
            border-radius: 30px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: none;
            font-size: 0.85rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

        .btn-secondary {
            background: linear-gradient(135deg, #718096, #4a5568);
            color: white;
        }

        .btn-secondary:hover {
            background: linear-gradient(135deg, #4a5568, #718096);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--brasil-green), #00b547);
            color: white;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #007a2d, var(--brasil-green));
        }

        .btn-success {
            background: linear-gradient(135deg, #28a745, #218838);
            color: white;
        }

        .btn-success:hover {
            background: linear-gradient(135deg, #218838, #28a745);
        }

        .btn-danger {
            background: linear-gradient(135deg, var(--burger-orange), #ff8659);
            color: white;
        }

        .btn-danger:hover {
            background: linear-gradient(135deg, #e55a28, var(--burger-orange));
        }

        .mb-3 {
            margin-bottom: 1rem !important;
        }

        .mb-4 {
            margin-bottom: 1.5rem !important;
        }

        /* Alerts */
        .alert {
            border: none;
            border-radius: 16px;
            padding: 1.25rem 1.5rem;
            font-weight: 500;
            animation: slideDown 0.4s ease-out;
        }

        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .alert-success {
            background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
            color: #155724;
            border-left: 5px solid #28a745;
        }

        .alert-danger {
            background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
            color: #721c24;
            border-left: 5px solid #dc3545;
        }

        /* Cards */
        .card {
            background: white;
            border: 1px solid rgba(0,0,0,0.06);
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            overflow: hidden;
            animation: fadeInUp 0.5s ease-out;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 30px rgba(0,0,0,0.12);
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .card-header {
            padding: 1.5rem;
            border: none;
            color: white;
            font-weight: 800;
        }

        .card-header h5 {
            margin: 0;
            font-size: 1.2rem;
            letter-spacing: -0.3px;
        }

        .bg-primary {
            background: linear-gradient(135deg, var(--brasil-green), #00b547) !important;
        }

        .bg-info {
            background: linear-gradient(135deg, var(--teal), #20c9e3) !important;
        }

        .bg-success {
            background: linear-gradient(135deg, #28a745, #218838) !important;
        }

        .bg-secondary {
            background: linear-gradient(135deg, #6c757d, #5a6268) !important;
        }

        .bg-warning {
            background: linear-gradient(135deg, var(--brasil-yellow), #f0c800) !important;
            color: var(--dark-text) !important;
        }

        .bg-dark {
            background: linear-gradient(135deg, #343a40, #23272b) !important;
        }

        .card-body {
            padding: 2rem;
        }

        /* Tables */
        .table {
            color: var(--dark-text);
            margin-bottom: 0;
        }

        .table-borderless td {
            padding: 0.75rem 0;
        }

        .table thead th {
            background: transparent;
            border-bottom: 2px solid #e2e8f0;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 1px;
            color: #718096;
            padding: 1rem 0.5rem;
        }

        .table tbody tr {
            border-bottom: 1px solid #e2e8f0;
            transition: background 0.2s ease;
        }

        .table tbody tr:hover {
            background: rgba(0, 151, 57, 0.03);
        }

        .table tbody tr:last-child {
            border-bottom: none;
        }

        .table tbody td,
        .table tfoot td {
            padding: 1rem 0.5rem;
            vertical-align: middle;
        }

        .table-success {
            background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
            font-weight: 700;
        }

        /* Badges */
        .badge {
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }

        .badge.fs-6 {
            font-size: 1rem !important;
            padding: 0.75rem 1.5rem;
        }

        .badge.bg-danger {
            background: linear-gradient(135deg, #dc3545, #c82333) !important;
        }

        .badge.bg-success {
            background: linear-gradient(135deg, #28a745, #218838) !important;
        }

        .badge.bg-warning {
            background: linear-gradient(135deg, var(--brasil-yellow), #f0c800) !important;
            color: var(--dark-text) !important;
        }

        .badge.bg-info {
            background: linear-gradient(135deg, var(--teal), #20c9e3) !important;
        }

        .badge.bg-secondary {
            background: linear-gradient(135deg, #6c757d, #5a6268) !important;
        }

        .badge.bg-primary {
            background: linear-gradient(135deg, var(--brasil-green), #00b547) !important;
        }

        /* Timeline */
        .timeline-item {
            border-left: 4px solid var(--brasil-green);
            padding-left: 20px;
            margin-left: 10px;
            position: relative;
            transition: all 0.3s ease;
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -8px;
            top: 8px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: var(--brasil-green);
            border: 3px solid white;
            box-shadow: 0 0 0 2px var(--brasil-green);
        }

        .timeline-item:hover {
            background: rgba(0, 151, 57, 0.03);
            border-radius: 8px;
            padding-right: 10px;
        }

        /* Form elements */
        .form-label {
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #718096;
            margin-bottom: 0.5rem;
        }

        .form-select,
        .form-control {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            background: #f7fafc;
        }

        .form-select:focus,
        .form-control:focus {
            border-color: var(--brasil-green);
            box-shadow: 0 0 0 4px rgba(0, 151, 57, 0.1);
            background: white;
            outline: none;
        }

        .input-group {
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            border-radius: 12px;
            overflow: hidden;
        }

        /* Text utilities */
        .text-muted {
            color: #718096 !important;
        }

        .text-end {
            text-align: right;
        }

        .text-center {
            text-align: center;
        }

        /* Responsive */
        @media (max-width: 768px) {
            h2 {
                font-size: 2rem;
            }

            .btn {
                width: 100%;
                margin-bottom: 0.5rem;
            }

            .input-group {
                width: 100% !important;
            }

            .d-inline-block {
                display: block !important;
                width: 100%;
            }

            .me-2 {
                margin-right: 0 !important;
                margin-bottom: 1rem;
            }
        }

        /* Animation delays for cards */
        .row > div:nth-child(1) .card { animation-delay: 0.1s; }
        .row > div:nth-child(2) .card { animation-delay: 0.2s; }
        .card:nth-of-type(3) { animation-delay: 0.3s; }
        .card:nth-of-type(4) { animation-delay: 0.4s; }
        .card:nth-of-type(5) { animation-delay: 0.5s; }
        .card:nth-of-type(6) { animation-delay: 0.6s; }
    </style>
</head>
<body>
<div class="container mt-4">
    <h2>📦 Commande #{{ commande.numero }}</h2>
    
    <a href="{{ path('admin_commandes') }}" class="btn btn-secondary mb-3">← Retour</a>
    
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">
            ✅ {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
    
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show">
            ❌ {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
    
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">📋 Informations</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <td><strong>Numéro:</strong></td>
                            <td>#{{ commande.numero }}</td>
                        </tr>
                        <tr>
                            <td><strong>Date:</strong></td>
                            <td>{{ commande.date_commande|date('d/m/Y à H:i') }}</td>
                        </tr>
                        <tr>
                            <td><strong>Statut:</strong></td>
                            <td>
                                <span class="badge fs-6 bg-{% if commande.statut == 'ANNULEE' %}danger{% elseif commande.statut in ['LIVREE', 'PRETE'] %}success{% elseif commande.statut == 'EN_ATTENTE' %}warning{% else %}info{% endif %}">
                                    {{ commande.statut|upper }}
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Mode:</strong></td>
                            <td>
                                {% if commande.mode_consommation == 'SUR_PLACE' %}🍽️ Sur place
                                {% elseif commande.mode_consommation == 'EMPORTER' %}📦 À emporter
                                {% else %}🚗 Livraison
                                {% endif %}
                            </td>
                        </tr>
                        {% if commande.temps_estimation_livraison %}
                        <tr>
                            <td><strong>Délai estimé:</strong></td>
                            <td>{{ commande.temps_estimation_livraison }} minutes</td>
                        </tr>
                        {% endif %}
                    </table>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">👤 Client</h5>
                </div>
                <div class="card-body">
                    <p><strong>Nom:</strong> {{ commande.client_nom }} {{ commande.client_prenom }}</p>
                    <p><strong>Téléphone:</strong> {{ commande.client_telephone }}</p>
                    <p><strong>Email:</strong> {{ commande.client_email }}</p>
                    
                    {% if commande.mode_consommation == 'LIVRAISON' and commande.rue %}
                    <hr>
                    <h6>📍 Adresse</h6>
                    <p class="mb-0">{{ commande.rue }}, N°{{ commande.adresse_numero }}</p>
                    <p class="mb-0">{{ commande.quartier_nom }} - {{ commande.zone_nom }}</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    
    <div class="card mb-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">🍔 Produits</h5>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Produit</th>
                        <th>Type</th>
                        <th class="text-center">Qté</th>
                        <th class="text-end">Prix U.</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ligne in lignes %}
                    <tr>
                        <td><strong>{{ ligne.produit_nom }}</strong></td>
                        <td><span class="badge bg-secondary">{{ ligne.produit_type }}</span></td>
                        <td class="text-center">{{ ligne.quantite }}</td>
                        <td class="text-end">{{ ligne.prix_unitaire|number_format(0, ',', ' ') }} FCFA</td>
                        <td class="text-end"><strong>{{ ligne.sous_total|number_format(0, ',', ' ') }} FCFA</strong></td>
                    </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="table-success">
                        <td colspan="4" class="text-end"><strong>TOTAL:</strong></td>
                        <td class="text-end"><h5>{{ commande.montant_total|number_format(0, ',', ' ') }} FCFA</h5></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    
    {% if commande.mode_consommation == 'LIVRAISON' %}
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">🚗 Livraison</h5>
        </div>
        <div class="card-body">
            {% if livraison %}
            <p><strong>Livreur:</strong> {{ livraison.livreur_nom }} - {{ livraison.livreur_telephone }}</p>
            <p><strong>Statut:</strong> <span class="badge bg-info">{{ livraison.statut }}</span></p>
            {% if livraison.date_debut %}
            <p><strong>Début livraison:</strong> {{ livraison.date_debut|date('d/m/Y H:i') }}</p>
            {% endif %}
            {% else %}
            <p class="text-muted">Aucun livreur affecté</p>
            {% endif %}
            
            {% if commande.statut == 'PRETE' %}
            <form method="post" action="{{ path('admin_commande_affecter_livreur', {id: commande.id}) }}" class="mt-3">
                <label class="form-label"><strong>Affecter un livreur:</strong></label>
                <div class="input-group">
                    <select name="livreur_id" class="form-select" required>
                        <option value="">Sélectionner...</option>
                        {% for livreur in livreurs %}
                        <option value="{{ livreur.id }}">{{ livreur.nom }} - {{ livreur.telephone }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="btn btn-primary">Affecter</button>
                </div>
            </form>
            {% endif %}
        </div>
    </div>
    {% endif %}
    
    <!-- Historique des statuts -->
    {% if historique is not empty %}
    <div class="card mb-4">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">📜 Historique des Statuts</h5>
        </div>
        <div class="card-body">
            {% for h in historique %}
            <div class="timeline-item mb-3 pb-3 {% if not loop.last %}border-bottom{% endif %}">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        {% if h.ancien_statut %}
                        <span class="badge bg-secondary">{{ h.ancien_statut }}</span>
                        <span>→</span>
                        {% endif %}
                        <span class="badge bg-primary">{{ h.nouveau_statut }}</span>
                    </div>
                    <small class="text-muted">{{ h.changed_at|date('d/m/Y H:i:s') }}</small>
                </div>
                <div class="mt-2">
                    <small><strong>Par:</strong> {{ h.changed_by }}</small>
                    {% if h.notes %}
                    <br><small class="text-muted">📝 {{ h.notes }}</small>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
    
    {% if statutsAutorises is not empty %}
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">⚙️ Actions</h5>
        </div>
        <div class="card-body">
            <form method="post" action="{{ path('admin_commande_update_statut', {id: commande.id}) }}" class="d-inline-block me-2">
                <div class="input-group" style="width: 300px;">
                    <select name="statut" class="form-select" required>
                        <option value="">Changer le statut...</option>
                        {% for key, label in statutsAutorises %}
                        <option value="{{ key }}">{{ label }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="btn btn-success">Valider</button>
                </div>
            </form>
            
            {% if commande.statut not in ['ANNULEE', 'LIVREE'] %}
            <form method="post" action="{{ path('admin_commande_annuler', {id: commande.id}) }}" class="d-inline-block">
                <button type="submit" class="btn btn-danger" onclick="return confirm('Confirmer l\'annulation ?')">
                    ❌ Annuler la Commande
                </button>
            </form>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>