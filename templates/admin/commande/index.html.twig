<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ page_title }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="container mt-4">
    <h1>Liste des Commandes</h1>
    
    <a href="{{ path('app_admin_dashboard') }}" class="btn btn-secondary mb-3">← Retour Dashboard</a>
    <a href="{{ path('app_logout') }}" class="btn btn-danger mb-3">🚪 Déconnexion</a>
    
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
    
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
    
    <!-- Filtres -->
    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5>🔍 Filtres de Recherche</h5>
        </div>
        <div class="card-body">
            <form method="get" action="{{ path('admin_commandes') }}">
                <div class="row">
                    <div class="col-md-3">
                        <label class="form-label">Statut</label>
                        <select name="statut" class="form-select">
                            <option value="">Tous les statuts</option>
                            <option value="EN_ATTENTE" {{ filtreStatut == 'EN_ATTENTE' ? 'selected' : '' }}>⏳ En attente</option>
                            <option value="CONFIRMEE" {{ filtreStatut == 'CONFIRMEE' ? 'selected' : '' }}>✅ Confirmée</option>
                            <option value="EN_PREPARATION" {{ filtreStatut == 'EN_PREPARATION' ? 'selected' : '' }}>👨‍🍳 En préparation</option>
                            <option value="PRETE" {{ filtreStatut == 'PRETE' ? 'selected' : '' }}>✔️ Prête</option>
                            <option value="EN_LIVRAISON" {{ filtreStatut == 'EN_LIVRAISON' ? 'selected' : '' }}>🚗 En livraison</option>
                            <option value="LIVREE" {{ filtreStatut == 'LIVREE' ? 'selected' : '' }}>📬 Livrée</option>
                            <option value="ANNULEE" {{ filtreStatut == 'ANNULEE' ? 'selected' : '' }}>❌ Annulée</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Type</label>
                        <select name="type" class="form-select">
                            <option value="">Tous les types</option>
                            <option value="BURGER" {{ filtreType == 'BURGER' ? 'selected' : '' }}>Burger</option>
                            <option value="MENU" {{ filtreType == 'MENU' ? 'selected' : '' }}>Menu</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Date</label>
                        <input type="date" name="date" class="form-control" value="{{ filtreDate }}">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Client</label>
                        <input type="text" name="client" class="form-control" placeholder="Nom, prénom ou tél" value="{{ filtreClient }}">
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Filtrer</button>
                    </div>
                </div>
                {% if filtreStatut or filtreDate or filtreClient or filtreType %}
                <div class="mt-2">
                    <a href="{{ path('admin_commandes') }}" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
                </div>
                {% endif %}
            </form>
        </div>
    </div>
    
    <div class="mb-3">
        <small class="text-muted">Total : {{ total }} commande(s) - Page {{ page }} sur {{ totalPages }}</small>
    </div>
    
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Client</th>
                <th>Montant</th>
                <th>Statut</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% if commandes is empty %}
                <tr>
                    <td colspan="6" class="text-center text-muted">Aucune commande trouvée</td>
                </tr>
            {% else %}
                {% for commande in commandes %}
                <tr>
                    <td>{{ commande.id }}</td>
                    <td>{{ commande.client_nom }} {{ commande.client_prenom }}</td>
                    <td>{{ commande.montant_total|number_format(0, ',', ' ') }} FCFA</td>
                    <td>
                        <span class="badge bg-{% if commande.statut == 'ANNULEE' %}danger{% elseif commande.statut in ['LIVREE', 'PRETE'] %}success{% elseif commande.statut == 'EN_ATTENTE' %}warning{% else %}info{% endif %}">
                            {{ commande.statut }}
                        </span>
                    </td>
                    <td>{{ commande.date_commande|date('d/m/Y H:i') }}</td>
                    <td>
                        <a href="{{ path('admin_commande_details', {id: commande.id}) }}" class="btn btn-sm btn-info">Détails</a>
                        {% if commande.statut not in ['ANNULEE', 'LIVREE'] %}
                        <form method="post" action="{{ path('admin_commande_annuler', {id: commande.id}) }}" style="display: inline;">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Annuler cette commande ?')">❌</button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            {% endif %}
        </tbody>
    </table>
    
    <!-- Pagination -->
    {% if totalPages > 1 %}
    <nav aria-label="Pagination">
        <ul class="pagination justify-content-center">
            {% if page > 1 %}
            <li class="page-item">
                <a class="page-link" href="{{ path('admin_commandes', {
                    page: page - 1,
                    statut: filtreStatut,
                    date: filtreDate,
                    client: filtreClient,
                    type: filtreType
                }) }}">Précédent</a>
            </li>
            {% endif %}
            
            {% for p in 1..totalPages %}
                {% if p == page %}
                <li class="page-item active"><span class="page-link">{{ p }}</span></li>
                {% elseif p <= 3 or p >= totalPages - 3 or (p >= page - 1 and p <= page + 1) %}
         <li class="page-item">
    <a class="page-link" href="{{ path('admin_commandes', {
                        page: p,
                        statut: filtreStatut,
                        date: filtreDate,
                        client: filtreClient,
                        type: filtreType
                    }) }}">{{ p }}</a>
    </li>
    {% elseif p == 4 or p == totalPages - 3 %}
    <li class="page-item disabled"><span class="page-link">...</span></li>
    {% endif %}
    {% endfor %}
            {% if page < totalPages %}
            <li class="page-item">
                <a class="page-link" href="{{ path('admin_commandes', {
                    page: page + 1,
                    statut: filtreStatut,
                    date: filtreDate,
                    client: filtreClient,
                    type: filtreType
                }) }}">Suivant</a>
            </li>
            {% endif %}
        </ul>
    </nav>
    {% endif %}
 </div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>