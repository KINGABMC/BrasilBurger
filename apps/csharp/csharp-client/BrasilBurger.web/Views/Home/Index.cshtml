@{
    ViewData["Title"] = "Brasil Burger";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        h1 {
            color: #d32f2f;
            text-align: center;
        }
        .status {
            padding: 15px;
            border-radius: 5px;
            margin: 20px 0;
        }
        .success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
        .stats {
            display: flex;
            justify-content: space-around;
            margin: 30px 0;
        }
        .stat-box {
            text-align: center;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 5px;
            flex: 1;
            margin: 0 10px;
        }
        .stat-number {
            font-size: 2em;
            font-weight: bold;
            color: #d32f2f;
        }
        .products {
            margin-top: 30px;
        }
        .product {
            padding: 10px;
            border-bottom: 1px solid #eee;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🍔 Brasil Burger</h1>
        
        @if (ViewBag.DatabaseStatus != null)
        {
            <div class="status @(ViewBag.DatabaseStatus.Contains("✅") ? "success" : "error")">
                <h3>Database Status: @ViewBag.DatabaseStatus</h3>
            </div>
        }
        
        <div class="stats">
            @if (ViewBag.ProduitCount != null)
            {
                <div class="stat-box">
                    <div class="stat-number">@ViewBag.ProduitCount</div>
                    <div>Produits</div>
                </div>
            }
            
            @if (ViewBag.ClientCount != null)
            {
                <div class="stat-box">
                    <div class="stat-number">@ViewBag.ClientCount</div>
                    <div>Clients</div>
                </div>
            }
        </div>
        
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="status error">
                <h4>Error Details:</h4>
                <p>@ViewBag.ErrorMessage</p>
            </div>
        }
        
        <div style="text-align: center; margin-top: 30px;">
            <a href="/Home/TestDB" style="background: #d32f2f; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">
                Tester la connexion DB
            </a>
        </div>
    </div>
</body>
</html>