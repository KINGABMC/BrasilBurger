@using BrasilBurger.Web.Controllers
@{
    ViewData["Title"] = "Mon Panier - Brasil Burger";
    var panier = ViewBag.Panier as List<SessionPanierItem>;
    var total = ViewBag.Total ?? 0;
    var panierCount = ViewBag.PanierCount ?? 0;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --brasil-green: #009739;
            --brasil-yellow: #FEDF00;
            --brasil-blue: #002776;
            --brasil-red: #DC3545;
        }

        body { background-color: #f8f9fa; }

        .panier-item {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
        }

        .panier-item:hover {
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
        }

        .quantite-control {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .quantite-control button {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            border: 1px solid #dee2e6;
            background: white;
        }

        .quantite-control input {
            width: 60px;
            text-align: center;
            border-radius: 8px;
            border: 1px solid #dee2e6;
            padding: 5px;
        }

        .total-box {
            background: linear-gradient(135deg, var(--brasil-blue) 0%, var(--brasil-green) 100%);
            color: white;
            border-radius: 12px;
            padding: 2rem;
        }

        .btn-commander {
            background: linear-gradient(135deg, var(--brasil-red) 0%, var(--brasil-green) 100%);
            color: white;
            border: none;
            padding: 1rem 2rem;
            font-size: 1.2rem;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-commander:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(220, 53, 69, 0.3);
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-dark" style="background: linear-gradient(135deg, var(--brasil-blue) 0%, var(--brasil-green) 100%);">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <span class="text-warning">🍔 BRASIL</span> BURGER
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light">
                <i class="fas fa-arrow-left"></i> Continuer mes achats
            </a>
        </div>
    </nav>

    <div class="container py-5">
        <h1 class="mb-4"><i class="fas fa-shopping-cart text-danger"></i> Mon Panier</h1>

        @if (panier != null && panier.Any())
        {
            <div class="row">
                <!-- Articles du panier -->
                <div class="col-lg-8">
                    @foreach (var item in panier)
                    {
                        <div class="panier-item">
                            <div class="row align-items-center">
                                <div class="col-md-2">
                                    <img src="@item.ImageUrl" alt="@item.Nom" class="img-fluid rounded" style="height: 80px; object-fit: cover;">
                                </div>
                                <div class="col-md-4">
                                    <h6 class="mb-1">@item.Nom</h6>
                                    <small class="text-muted">@item.Type</small>
                                </div>
                                <div class="col-md-3">
                                    <div class="quantite-control">
                                        <button class="btn-sm" onclick="modifierQuantite(@item.ProduitId, @item.Quantite - 1)">
                                            <i class="fas fa-minus"></i>
                                        </button>
                                        <input type="text" value="@item.Quantite" readonly id="quantite-@item.ProduitId">
                                        <button class="btn-sm" onclick="modifierQuantite(@item.ProduitId, @item.Quantite + 1)">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-3 text-end">
                                    <h5 class="text-success mb-0">@item.SousTotal.ToString("N0") FCFA</h5>
                                    <small>@item.Prix.ToString("N0") FCFA × @item.Quantite</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Récapitulatif -->
                <div class="col-lg-4">
                    <div class="total-box mb-4">
                        <h4 class="text-center mb-4">Récapitulatif</h4>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Sous-total:</span>
                            <span>@total.ToString("N0") FCFA</span>
                        </div>
                        <hr class="bg-light my-2">
                        <div class="d-flex justify-content-between mb-3">
                            <h5 class="mb-0">Total:</h5>
                            <h3 class="mb-0" id="totalAmount">@total.ToString("N0") FCFA</h3>
                        </div>
                    </div>

                    <!-- Bouton Commander -->
                    @{
                        var clientId = Context.Session.GetString("ClientId");
                        if (string.IsNullOrEmpty(clientId))
                        {
                            <a asp-controller="Client" asp-action="Login" asp-route-returnUrl="/Home/Commander" class="btn btn-commander w-100">
                                <i class="fas fa-sign-in-alt"></i> SE CONNECTER POUR COMMANDER
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Home" asp-action="Commander" class="btn btn-commander w-100">
                                <i class="fas fa-check-circle"></i> PASSER LA COMMANDE
                            </a>
                        }
                    }

                    <!-- Vider panier -->
                    <button class="btn btn-outline-danger w-100 mt-3" onclick="viderPanier()">
                        <i class="fas fa-trash"></i> Vider le panier
                    </button>

                    <!-- Retour -->
                    <div class="text-center mt-3">
                        <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                            <i class="fas fa-arrow-left"></i> Continuer mes achats
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-shopping-cart fa-4x text-muted mb-4"></i>
                <h3 class="text-muted">Votre panier est vide</h3>
                <p class="text-muted mb-4">Ajoutez des produits pour commencer vos achats</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-danger btn-lg">
                    <i class="fas fa-hamburger"></i> Voir le catalogue
                </a>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        async function modifierQuantite(produitId, nouvelleQuantite) {
            if (nouvelleQuantite < 0) return;
            
            try {
                const response = await fetch('/Home/MettreAJourPanier?produitId=' + produitId + '&quantite=' + nouvelleQuantite, {
                    method: 'POST'
                });
                
                const result = await response.json();
                if (result.success) {
                    // Recharger la page pour voir les changements
                    window.location.reload();
                }
            } catch (error) {
                alert('Erreur lors de la mise à jour');
            }
        }

        async function viderPanier() {
            if (!confirm('Êtes-vous sûr de vouloir vider votre panier ?')) return;
            
            try {
                const response = await fetch('/Home/ViderPanier', {
                    method: 'POST'
                });
                
                const result = await response.json();
                if (result.success) {
                    window.location.reload();
                }
            } catch (error) {
                alert('Erreur lors du vidage du panier');
            }
        }
    </script>
</body>
</html>